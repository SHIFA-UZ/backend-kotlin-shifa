# Gradle
.gradle/
build/

# IntelliJ IDEA
.idea/
*.iml
out/

# Logs (including rolled archives the app writes next to the jar)
*.log
*.log.*

# OS
.DS_Store
Thumbs.db

# Env
.env

# Docker
*.pid

# Node (if any frontend later)
node_modules/

# Secrets (local overrides only; application-dev.yml is the tracked Railway development profile)
application-local.yml

# Local upload storage (patient documents, photos, voice recordings).
# Created at runtime under storageRoot; never commit these files.
/public-storage/
/images/

# Knowledge graph cache
graphify-out/

# One-off SQL scripts belong in docs/sql/, never in the repo root
/*.sql

# Git worktrees used for parallel branches
.worktrees/
